{
  "name": "marketplace-app-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run format && TYPED_ROUTES=true next build",
    "dev": "next dev -p 4421 --turbo",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --check --ignore-path .prettierignore .",
    "format:fix": "prettier --write --ignore-path .prettierignore .",
    "start": "next start -p 4421",
    "check": "tsc --noEmit",
    "knip": "knip",
    "env-file": "cp -n .env.example .env",
    "sdk:prerelease-refresh": "pnpm remove @0xsequence/marketplace-sdk && pnpm add @0xsequence/marketplace-sdk@github:0xsequence/marketplace-sdk#pre-release"
  },
  "dependencies": {
    "0xsequence": "^2.3.39",
    "@0xsequence/api": "^2.3.39",
    "@0xsequence/checkout": "^5.4.8",
    "@0xsequence/connect": "^5.4.8",
    "@0xsequence/design-system": "^3.1.7",
    "@0xsequence/hooks": "^5.4.8",
    "@0xsequence/indexer": "^2.3.39",
    "@0xsequence/marketplace-sdk": "github:0xsequence/marketplace-sdk#pre-release",
    "@0xsequence/metadata": "^2.3.39",
    "@0xsequence/network": "^2.3.39",
    "@0xsequence/wallet-widget": "^5.4.8",
    "@databeat/tracker": "^0.9.3",
    "@google/model-viewer": "^4.1.0",
    "@nanostores/react": "^1.0.0",
    "@next/bundle-analyzer": "^15.5.9",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "5.90.9",
    "@tanstack/react-query-devtools": "5.91.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.16.0",
    "fuse.js": "^7.1.0",
    "motion": "^12.23.26",
    "nanostores": "^1.1.0",
    "next": "15.3.6",
    "nuqs": "2.8.1",
    "radash": "^12.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.0",
    "react-virtuoso": "4.14.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "three": "0.181.2",
    "viem": "2.41.2",
    "wagmi": "2.18.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.9",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.47.0",
    "vercel": "44.7.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "cross-fetch": "./fetch-override",
      "vercel": "$vercel",
      "@0xsequence/indexer-v2": "npm:@0xsequence/indexer@2.3.38",
      "@0xsequence/design-system-v2": "npm:@0xsequence/design-system@2.1.11"
    },
    "onlyBuiltDependencies": [
      "@0xsequence/marketplace-sdk",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@vercel/next@4.11.0": "patches/@vercel__next@4.11.0.patch"
    }
  }
}
